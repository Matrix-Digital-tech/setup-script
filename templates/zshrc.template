# ~/.zshrc — generated by setup-script
# Review this file and merge into your existing ~/.zshrc
# Generated: {{DATE}}

# ── Homebrew ──────────────────────────────────────────────────────────────────
# Apple Silicon: /opt/homebrew — Intel: /usr/local
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# ── Oh My Zsh ─────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Disabled — using Starship prompt below

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-completions
  fzf
  gh
  docker
  aws
  node
  python
)

source "$ZSH/oh-my-zsh.sh"

# ── Starship prompt ───────────────────────────────────────────────────────────
eval "$(starship init zsh)"

# ── Node (fnm) ────────────────────────────────────────────────────────────────
eval "$(fnm env --use-on-cd --shell zsh)"

# ── Python (uv) ───────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$PATH"

# ── zoxide (smart cd) ─────────────────────────────────────────────────────────
eval "$(zoxide init zsh --cmd cd)"

# ── fzf ───────────────────────────────────────────────────────────────────────
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'

# ── PostgreSQL ────────────────────────────────────────────────────────────────
export PATH="$(brew --prefix)/opt/postgresql@16/bin:$PATH"

# ── Modern CLI aliases ────────────────────────────────────────────────────────
alias ls='eza --icons --group-directories-first'
alias ll='eza --icons --group-directories-first -la'
alias lt='eza --icons --tree --level=2'
alias cat='bat --paging=never'
alias find='fd'

# ── Git aliases ───────────────────────────────────────────────────────────────
alias gs='git status'
alias gl='git log --oneline --graph --decorate --all'
alias gd='git diff'

# ── Claude Code ───────────────────────────────────────────────────────────────
alias claude-pro="claude"

# ── Google Workspace CLI (gws) ────────────────────────────────────────────────
# Run 'gws auth' to authenticate on first use

# ── Environment ───────────────────────────────────────────────────────────────
export EDITOR="code --wait"

# ── API Keys ──────────────────────────────────────────────────────────────────
# Keys are read from 1Password at shell startup — never stored as plain text.
# Store each key in 1Password first, then update the path below.
# Format: op://VaultName/ItemName/field  (find paths via: op item list)
export PERPLEXITY_API_KEY="$(op read 'op://Development/Perplexity/api_key' 2>/dev/null)"

# ── Local overrides ───────────────────────────────────────────────────────────
# Machine-specific config — not committed to the repo
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local


# ════════════════════════════════════════════════════════════════════════════════
# PROJECT-SPECIFIC CONFIG
# ════════════════════════════════════════════════════════════════════════════════

# ── Scintilla ─────────────────────────────────────────────────────────────────
export SCINTILLA_HOME="$HOME/Documents/Github/scintilla"

# ── CMS ───────────────────────────────────────────────────────────────────────
alias claude-cms='AWS_PROFILE=cms CLAUDE_CODE_USE_BEDROCK=1 AWS_REGION=us-east-1 ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-6 claude'
alias opencode-cms='AWS_PROFILE=cms AWS_REGION=us-east-1 opencode'

kion-cms() {
  python3 -c "
import re, sys
f = sys.argv[1]
txt = open(f).read()
txt = re.sub(r'\[cms\]\n(?:[^\[]*\n?)*', '', txt)
open(f, 'w').write(txt)
" ~/.aws/credentials 2>/dev/null
  local key; key=$(security find-generic-password -a "$USER" -s kion-cms -w 2>/dev/null)
  KION_API_KEY="$key" kion stak --save
  python3 -c "
f = '$HOME/.aws/credentials'
txt = open(f).read()
import re
txt = re.sub(r'^\[\d+_[^\]]*\]', '[cms]', txt, flags=re.MULTILINE)
open(f, 'w').write(txt)
"
  echo "\n✅ Credentials updated and renamed to [cms]."
}

kion-rotate-cms() {
  local current_key; current_key=$(security find-generic-password -a "$USER" -s kion-cms -w 2>/dev/null)
  if [[ -z "$current_key" ]]; then
    echo "❌ No key in keychain. Add with:"
    echo "   security add-generic-password -a \"\$USER\" -s kion-cms -w <your-api-key>"
    return 1
  fi
  local response new_key
  response=$(curl -s -X POST \
    -H "Authorization: Bearer $current_key" \
    -H "Content-Type: application/json" \
    -d "{\"key\": \"$current_key\"}" \
    "https://cloudtamer.cms.gov/api/v3/app-api-key/rotate")
  new_key=$(python3 -c "import sys, json; print(json.load(sys.stdin)['data']['key'])" <<< "$response" 2>/dev/null)
  if [[ -z "$new_key" ]]; then
    echo "❌ Rotation failed. Response: $response"
    return 1
  fi
  security add-generic-password -U -a "$USER" -s kion-cms -w "$new_key"
  echo "✅ Key rotated and saved to keychain."
}

# ── Verdance ──────────────────────────────────────────────────────────────────
alias claude-verdance='AWS_PROFILE=verdance CLAUDE_CODE_USE_BEDROCK=1 AWS_REGION=us-east-1 ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-6 claude'

# ── Matrix Digital ────────────────────────────────────────────────────────────
alias claude-matrix='AWS_ACCESS_KEY_ID=x AWS_SECRET_ACCESS_KEY=x AWS_BEARER_TOKEN_BEDROCK=$(cat ~/.aws/bedrock/matrix 2>/dev/null) CLAUDE_CODE_USE_BEDROCK=1 AWS_REGION=us-east-1 ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-6 claude'
